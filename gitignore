node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------- Build-output ----------
dist/
dist-ssr/
build/
.output/
.nuxt/
.vite/
.cache/
.parcel-cache/
*.local

